{
  "info": {
    "_postman_id": "handle-service-api-tests",
    "name": "handle-service 全接口测试",
    "description": "基于当前后端 Controller 生成的 Postman 测试集合。请配合 docs/handle-service.postman_environment.json 使用。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let suffix = pm.environment.get('runSuffix');",
          "if (!suffix) {",
          "  suffix = Date.now().toString();",
          "  pm.environment.set('runSuffix', suffix);",
          "}",
          "if (!pm.environment.get('testUserAccount')) pm.environment.set('testUserAccount', 'postman_user_' + suffix);",
          "if (!pm.environment.get('testUserNum')) pm.environment.set('testUserNum', 'UPM' + suffix.slice(-8));",
          "if (!pm.environment.get('testStratumId')) pm.environment.set('testStratumId', 'S_PM_' + suffix.slice(-8));",
          "if (!pm.environment.get('testImageId')) pm.environment.set('testImageId', 'IMG_PM_' + suffix.slice(-8));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('登录成功', function () { pm.expect(json.success).to.eql(true); });",
                  "if (json.data && json.data.token) pm.environment.set('token', json.data.token);",
                  "if (json.data && json.data.userId !== undefined) pm.environment.set('userId', String(json.data.userId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/post/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "login"
              ]
            }
          }
        },
        {
          "name": "管理员登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('管理员登录成功', function () { pm.expect(json.success).to.eql(true); });",
                  "if (json.data && json.data.token) pm.environment.set('adminToken', json.data.token);"
                ]
