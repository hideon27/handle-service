            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/post/adminLogin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "adminLogin"
              ]
            }
          }
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/userinfo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "userinfo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('当前用户信息成功', function () { pm.expect(json.success).to.eql(true); });",
                  "pm.test('包含客户端需要的用户字段', function () {",
                  "  const user = json.data && json.data.result;",
                  "  pm.expect(user).to.have.property('id');",
                  "  pm.expect(user).to.have.property('uName');",
                  "  pm.expect(user).to.have.property('uAccount');",
                  "  pm.expect(user).to.have.property('uEmail');",
                  "  pm.expect(user).to.have.property('uTel');",
                  "  pm.expect(user).to.have.property('uRegdate');",
                  "  pm.expect(user).to.have.property('uNum');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
